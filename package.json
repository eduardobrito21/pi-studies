{
  "name": "kanban-agent-study",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"bun run dev:api\" \"bun run dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "bun --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "bun test",
    "pi:smoke": "bun server/pi-smoke.ts",
    "pi:models": "bun server/pi-models.ts",
    "pi:check": "bun server/pi-models.ts --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun test && bun run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/vite": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^17.0.0",
    "effect": "3.22.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@shadcn/lint": "0.2.0",
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "packageManager": "bun@1.4.2"
}
