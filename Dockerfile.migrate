FROM oven/bun:1.4.2-slim AS bun

# Node supports Prisma's helpers; Bun installs and runs the migration CLI.
FROM node:22-bookworm-slim
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=true
# Keep the CLI version aligned with package.json. No application dependencies.
RUN bun add --exact prisma@7.10.0 dotenv@17.4.2
COPY prisma.config.ts ./
COPY prisma ./prisma

CMD ["bun", "run", "prisma", "migrate", "deploy"]
